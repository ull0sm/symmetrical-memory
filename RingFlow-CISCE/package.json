{
  "name": "ringflow",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:local": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:verify": "next build --debug-prerender",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "tsx scripts/verify-draw-guard.ts && tsx scripts/verify-draw-setup.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "npx tsx scripts/apply-migrations.ts",
    "db:bootstrap": "npx tsx scripts/bootstrap-db.ts",
    "db:seed": "npx tsx scripts/seed-realistic-tournament.ts",
    "db:reset": "npx tsx scripts/reset-and-seed-clean.ts",
    "db:create-admin": "npx tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@marsidev/react-turnstile": "^1.5.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "regenerator-runtime": "^0.14.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
